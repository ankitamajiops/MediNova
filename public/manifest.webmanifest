{
  "name": "MediNova — Campus Health Sentinel",
  "short_name": "MediNova",
  "description": "Privacy-Preserving Community Health Early Warning & Syndromic Surveillance App for College Campuses",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#0d9488",
  "categories": ["medical", "health", "education", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Report Symptoms",
      "short_name": "Report",
      "description": "Quickly submit anonymous symptom report",
      "url": "/?role=student&tab=report-symptoms",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Campus Emergency 24/7",
      "short_name": "Emergency",
      "description": "Immediate campus medical emergency assistance",
      "url": "/?role=student&tab=emergency",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Health Surveillance Hub",
      "short_name": "Official Hub",
      "description": "Official syndromic surveillance & outbreak clusters",
      "url": "/?role=official&tab=dashboard",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Campus Risk Map",
      "short_name": "Risk Map",
      "description": "Interactive live campus risk schematics",
      "url": "/?role=official&tab=risk-map",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
